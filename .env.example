# Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=replace_me

# Your Discord account ID. This is the sole owner identity for .exe.
OWNER_ID=123456789012345678

# Optional comma-separated IDs allowed to use !exe (does not grant owner powers)
WHITELIST_IDS=

# Runtime safety limits
SCRIPT_TIMEOUT_SECONDS=5
MAX_SCRIPT_ACTIONS=20
