# Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=replace_me

# Your Discord account ID. This is the sole owner identity for .exe.
OWNER_ID=123456789012345678

# SQLite database file (created automatically)
DATABASE_PATH=data/exe.sqlite3

# Runtime safety limits
SCRIPT_TIMEOUT_SECONDS=300
MAX_SCRIPT_ACTIONS=1000
# Set true only if Server Members Intent is enabled in the Discord Developer Portal.
ENABLE_MEMBERS_INTENT=false
